# Exemplos PUBLICOS, exclusivos de desenvolvimento. Copie para .env (ignorado).
# Nao reutilize estas credenciais em ambientes compartilhados.
ASPNETCORE_ENVIRONMENT=Development
ORACLE_PASSWORD=123456
APP_USER=GuardianPet
APP_USER_PASSWORD=123456
Jwt__Key=GuardianPet-Development-Only-Replace-This-Key-2026!
Jwt__Issuer=GuardianPet
Jwt__Audience=GuardianPet
Jwt__ExpirationMinutes=60
# Opcional: substitui a conexao montada com APP_USER/APP_USER_PASSWORD no Compose.
# ConnectionStrings__OracleConnection='User Id=USUARIO;Password=SENHA;Data Source=HOST:1521/SERVICO'
# Variaveis do Oracle inicializam volumes novos; nao trocam senhas em volumes existentes.
