# Modelo público de configuração local. Substitua os placeholders antes de usar.
# Não incluir credenciais reais no versionamento. .env é ignorado pelo Git.
ASPNETCORE_ENVIRONMENT=Development
ORACLE_PASSWORD=SUBSTITUA_POR_SENHA_ADMIN_LOCAL
APP_USER=SUBSTITUA_POR_USUARIO_ORACLE_LOCAL
APP_USER_PASSWORD=SUBSTITUA_POR_SENHA_APP_LOCAL
Jwt__Key=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_BYTES
Jwt__Issuer=GuardianPet
Jwt__Audience=GuardianPet
Jwt__ExpirationMinutes=60

# Opcional: conexão privada; informe localmente, sem versionar.
# ConnectionStrings__OracleConnection=<CONEXAO_ORACLE_PRIVADA>

# Oracle: estas opções inicializam volumes novos, sem trocar senhas existentes.
# API no host: exporte as variáveis; dotnet não carrega .env automaticamente.
# Administração: usar o ID real da conta (não concedido pelo cadastro).
# Jwt__AdminUserIds__0=<ID_DA_CONTA_ADMINISTRATIVA>
# Compose: AdminUserIds precisa de encaminhamento via override local.

# MongoDB no Compose (perfil local-audit). Sem credenciais, somente desenvolvimento.
# Para API executada no host, trocar o hostname mongodb por localhost.
MongoDB__ConnectionString=mongodb://mongodb:27017
MongoDB__DatabaseName=guardianpet_audit
# O Compose encaminha ConnectionString e DatabaseName.
# Para opções adicionais no Compose, usar override local.
# MongoDB__CollectionName=audit_events
# MongoDB__TimeoutMilliseconds=1000
# GUARDIANPET_TEST_MONGO_CONNECTION=mongodb://localhost:27017
